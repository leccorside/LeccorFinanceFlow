# Application
NODE_ENV=development
# In Docker Compose, FRONTEND_PORT/BACKEND_PORT only choose the host ports;
# inside the containers the apps always listen on 5173 and 3000.
FRONTEND_PORT=5173
BACKEND_PORT=3000
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3000
API_PREFIX=/api/v1
APP_NAME=Leccor Finance Flow

# PostgreSQL (Docker development placeholders only)
POSTGRES_DB=leccor_finance_flow
POSTGRES_USER=leccor
# Use URL-safe characters (no @ : / ? #): Compose builds DATABASE_URL from these values.
POSTGRES_PASSWORD=change-me-for-local-development
# Host port published on 127.0.0.1; change it if 5432 is already in use locally.
POSTGRES_PORT=5432
# Inside Docker Compose this value is rebuilt from POSTGRES_* and points to the `postgres` service.
# Outside Docker, point it to a reachable PostgreSQL (e.g. localhost:${POSTGRES_PORT}).
DATABASE_URL=postgresql://leccor:change-me-for-local-development@postgres:5432/leccor_finance_flow?schema=public
# Integration tests only: server-level URL (database "postgres") whose user can CREATE DATABASE.
# Each test file creates and drops its own disposable database. Compose sets it inside the backend.
TEST_DATABASE_URL=postgresql://leccor:change-me-for-local-development@localhost:5432/postgres

# Application session (opaque tokens in HttpOnly cookies; only SHA-256 hashes are stored,
# so no signing secret is needed). Durations: <n>s, <n>m, <n>h or <n>d.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
# Secure cookie flag. Defaults to true when NODE_ENV=production; browsers accept Secure on http://localhost.
COOKIE_SECURE=false

# Encryption of stored credentials (Google tokens; AI keys later): AES-256-GCM.
# Each key is the base64 of exactly 32 random bytes. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Empty = encryption not configured: the Google connection answers "unavailable".
# Rotation: add DATA_ENCRYPTION_KEY_V2, set the active version to v2, restart, run
# `pnpm --filter @leccor/backend credentials:rotate`, then remove V1.
DATA_ENCRYPTION_KEY_V1=
DATA_ENCRYPTION_KEY_ACTIVE_VERSION=v1

# Google OAuth 2.0 and Google APIs
# Login is enabled only when both ID and secret are set; otherwise /auth/google/login answers 503.
# Create an OAuth client of type "Web application" in Google Cloud and register the redirect URI below
# exactly. Login scopes are fixed in code (openid email profile).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Goes through the frontend origin (Vite proxies /api), so all cookies share one origin.
GOOGLE_REDIRECT_URI=http://localhost:5173/api/v1/auth/google/callback
# Drive/Sheets consent (separate from login); register this URI in Google Cloud too.
# Scopes are fixed in code: openid email + drive.file (only files created/opened by the app).
GOOGLE_CONNECTION_REDIRECT_URI=http://localhost:5173/api/v1/google/callback

# AI providers (optional until configured by an administrator)
OPENAI_API_KEY=
OPENAI_DEFAULT_CHAT_MODEL=
GEMINI_API_KEY=
GEMINI_DEFAULT_CHAT_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_CHAT_MODEL=
AI_REQUEST_TIMEOUT_MS=30000

# Voice providers
STT_PROVIDER=
TTS_PROVIDER=
STT_API_KEY=
TTS_API_KEY=
MAX_AUDIO_SIZE_MB=10
MAX_AUDIO_DURATION_SECONDS=120

# Reports and temporary files
REPORT_TEMP_DIRECTORY=/tmp/leccor-finance-flow/reports
REPORT_FILE_TTL_MINUTES=30
MAX_REPORT_RANGE_MONTHS=120

# API protection
# Extra browser origins for CORS and the CSRF origin check (comma-separated).
# FRONTEND_URL is always allowed; leave empty when the SPA is the only client.
CORS_ALLOWED_ORIGINS=
# In-memory fixed-window limits per client IP (single backend instance; reset on restart).
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_REQUESTS=20
# Spreadsheet creation/repair (each one makes several Google API calls).
SPREADSHEET_RATE_LIMIT_MAX_REQUESTS=10
# Reserved for the assistant (PASSO 14) and voice (PASSO 17) routes; not used yet.
ASSISTANT_RATE_LIMIT_MAX_REQUESTS=30
VOICE_RATE_LIMIT_MAX_REQUESTS=10
MAX_JSON_BODY_SIZE=1mb
# Express "trust proxy": false, true, a hop count or a list (e.g. "loopback, uniquelocal").
# Set it only behind a reverse proxy you control, otherwise clients can spoof X-Forwarded-For.
TRUST_PROXY=false
# Comma-separated e-mails that receive the ADMIN role on Google login (bootstrap of admins).
ADMIN_EMAILS=

# Documentation and optional integration tests
SWAGGER_ENABLED=true
# Opt-in smoke test against the real Google APIs (`pnpm --filter @leccor/backend test:google`):
# needs GOOGLE_CLIENT_ID/SECRET and a refresh token (drive.file scope) of a TEST Google account.
RUN_GOOGLE_INTEGRATION_TESTS=false
GOOGLE_TEST_REFRESH_TOKEN=
RUN_AI_INTEGRATION_TESTS=false
