# Application
NODE_ENV=development
# In Docker Compose, FRONTEND_PORT/BACKEND_PORT only choose the host ports;
# inside the containers the apps always listen on 5173 and 3000.
FRONTEND_PORT=5173
BACKEND_PORT=3000
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3000
API_PREFIX=/api/v1
APP_NAME=Leccor Finance Flow

# PostgreSQL (Docker development placeholders only)
POSTGRES_DB=leccor_finance_flow
POSTGRES_USER=leccor
# Use URL-safe characters (no @ : / ? #): Compose builds DATABASE_URL from these values.
POSTGRES_PASSWORD=change-me-for-local-development
# Host port published on 127.0.0.1; change it if 5432 is already in use locally.
POSTGRES_PORT=5432
# Inside Docker Compose this value is rebuilt from POSTGRES_* and points to the `postgres` service.
# Outside Docker, point it to a reachable PostgreSQL (e.g. localhost:${POSTGRES_PORT}).
DATABASE_URL=postgresql://leccor:change-me-for-local-development@postgres:5432/leccor_finance_flow?schema=public

# Application session and encryption
# Generate independent, high-entropy values. Never reuse examples in production.
SESSION_SECRET=replace-with-at-least-32-random-bytes
JWT_ACCESS_SECRET=replace-with-at-least-32-random-bytes
JWT_REFRESH_SECRET=replace-with-another-32-random-bytes
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
# Base64-encoded 32-byte key for AES-256-GCM.
DATA_ENCRYPTION_KEY_V1=replace-with-base64-encoded-32-byte-key
DATA_ENCRYPTION_KEY_ACTIVE_VERSION=v1

# Google OAuth 2.0 and Google APIs
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback
GOOGLE_CONNECTION_REDIRECT_URI=http://localhost:3000/api/v1/google/callback
# Keep scopes minimal; the implementation owns the definitive scope list.
GOOGLE_OAUTH_SCOPES=openid email profile
GOOGLE_SHEETS_SCOPES=https://www.googleapis.com/auth/drive.file https://www.googleapis.com/auth/spreadsheets

# AI providers (optional until configured by an administrator)
OPENAI_API_KEY=
OPENAI_DEFAULT_CHAT_MODEL=
GEMINI_API_KEY=
GEMINI_DEFAULT_CHAT_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_CHAT_MODEL=
AI_REQUEST_TIMEOUT_MS=30000

# Voice providers
STT_PROVIDER=
TTS_PROVIDER=
STT_API_KEY=
TTS_API_KEY=
MAX_AUDIO_SIZE_MB=10
MAX_AUDIO_DURATION_SECONDS=120

# Reports and temporary files
REPORT_TEMP_DIRECTORY=/tmp/leccor-finance-flow/reports
REPORT_FILE_TTL_MINUTES=30
MAX_REPORT_RANGE_MONTHS=120

# API protection
CORS_ALLOWED_ORIGINS=http://localhost:5173
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=100
ASSISTANT_RATE_LIMIT_MAX_REQUESTS=30
VOICE_RATE_LIMIT_MAX_REQUESTS=10
MAX_JSON_BODY_SIZE=1mb

# Documentation and optional integration tests
SWAGGER_ENABLED=true
RUN_GOOGLE_INTEGRATION_TESTS=false
RUN_AI_INTEGRATION_TESTS=false
