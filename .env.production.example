# Production environment (copy to .env.production, never commit the copy).
# Used by: docker compose --env-file .env.production -f docker-compose.prod.yml up -d --build
# Every variable of .env.example is accepted; only what differs in production is listed.

# Public URL of the app (the `web` container behind your TLS proxy). Cookies, CORS, CSRF
# and OAuth redirects derive from it.
FRONTEND_URL=https://financas.example.com
WEB_PORT=8080

POSTGRES_DB=leccor_finance_flow
POSTGRES_USER=leccor
# Long random value: openssl rand -base64 32
POSTGRES_PASSWORD=

# Secure cookies are on by default in production; keep them on behind HTTPS.
COOKIE_SECURE=true
# Proxy hops in front of the backend: nginx (1) + your load balancer, if any.
TRUST_PROXY=1

# 32 random bytes in base64 (openssl rand -base64 32). Required for Google and AI keys.
DATA_ENCRYPTION_KEY_V1=
DATA_ENCRYPTION_KEY_ACTIVE_VERSION=v1

# Google Cloud OAuth client (Authorized redirect URIs: FRONTEND_URL + the two paths below).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://financas.example.com/api/v1/auth/google/callback
GOOGLE_CONNECTION_REDIRECT_URI=https://financas.example.com/api/v1/google/callback

# First administrators (comma separated).
ADMIN_EMAILS=

# Google Gemini (the only AI provider). Optional here: the key can also be stored, encrypted,
# in the admin console. Voice: set STT_PROVIDER=gemini and TTS_PROVIDER=gemini to turn it on.
GEMINI_API_KEY=
STT_PROVIDER=
TTS_PROVIDER=
